# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# Never commit .env.local.
# ---------------------------------------------------------------------------

# Neon Postgres connection string.
# Neon console -> your project -> Connection Details -> "Connection string".
# Use the POOLED connection string (host contains "-pooler") for serverless.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Session signing secret for Auth.js.
# Generate with:  npx auth secret
# or:             node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-random-32-byte-value"

# Encrypts participant access tokens at rest so moderators can re-open the
# Share page and see the same link. Without it a database dump yields no
# working feedback links.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# WARNING: changing this makes existing links unviewable in the dashboard
# (participants' links keep working). Moderators would need to rotate each link.
TOKEN_ENCRYPTION_KEY="replace-me-with-a-random-32-byte-base64-value"

# Public base URL used to build participant links and QR codes.
# Local:      http://localhost:3000
# Production: https://feedback.helpbnk.com
# If unset, the app falls back to the incoming request's host.
#
# This also tells Auth.js the deployment's own origin is trusted. Without it,
# a non-Vercel deployment (or a local production build on a custom port)
# rejects sign-in with "UntrustedHost". Set it to the URL people actually
# visit, including the port if it is not 80/443.
# Participant share links do NOT use this value: they follow the host of the
# request that renders the Share page, so they are correct on any domain.
APP_BASE_URL="http://localhost:3000"
